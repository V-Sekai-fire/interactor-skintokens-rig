[configuration]

entry_symbol = "riscv_library_init"
compatibility_minimum = "4.4"

[libraries]
web.debug.double.wasm32 = "./libgodot_riscv.web.template_release.double.wasm32.wasm"
web.release.double.wasm32 = "./libgodot_riscv.web.template_release.double.wasm32.wasm"
web.debug.wasm32 = "./libgodot_riscv.web.template_release.double.wasm32.wasm"
web.release.wasm32 = "./libgodot_riscv.web.template_release.double.wasm32.wasm"
macos.double = "./libgodot_riscv.macos.template_release.double.universal.framework"
windows.double.x86_64 = "./libgodot_riscv.windows.template_release.double.x86_64.dll"
linux.double.x86_64 = "./libgodot_riscv.linux.template_release.double.x86_64.so"
